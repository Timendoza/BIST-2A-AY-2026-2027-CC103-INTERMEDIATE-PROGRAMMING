# Mini system for a Python Module
import sys
import math
import random
import functions

print("=" * 70)

# Helper Functions
def get_float(prompt):
    while True:
        try:
            value = float(input(prompt))
            return value
        except ValueError:
            print(" >> Invalid input. Please type a number (e.g., -1.5).")
        except EOFError:
            print("\n >> No input received. Exiting program.")
            raise SystemExit

def get_int(prompt):
    while True:
        try:
            print(prompt, end="", flush=True)
            return int(input())
        except ValueError:
            print(" >> Invalid input. Please type a whole number.")
        except EOFError:
            print(" >> No input received. Exiting program.")
            raise SystemExit

def safe_input(prompt):
    try:
        print(prompt, end="", flush=True)
        return input()
    except EOFError:
        print("\nNo input received. Exiting program.")
        raise SystemExit

def pause():
    """Pauses as the user can read the result before the menu reappears."""
    safe_input("Press ENTER to return to the menu")

def print_header(title):
    print("\n" + "=" * 70)
    print(f"{title}")
    print("=" * 70)

# SECTION 1: TRIGONOMETRIC FUNCTIONS
# math.sin, math.cos, math.tan, math.acos, math.atan, math.pi, math.radians, math.degrees
def trig_menu():
    while True:
        print_header("TRIGONOMETRIC (CIRCULAR) FUNCTIONS")
        print("""
1. Show the value of pi
2. Converts degrees -> radians
3. Convert radians -> degrees
4. Compute sin, cos, tan of an angle (you enter degrees)
5. Compute asin, acos, atan, of a value(-1 to 1 for asin/acos)
0. Back to Main Menu
""")

        choice = safe_input("Enter your choice: ").strip()
        if choice == "1":
            print(f"\nmath.pi = {math.pi}")
            
        elif choice == "2":
            deg = get_float("Enter an angle in degrees: ")
            rad = math.radians(deg)
            print(f"\n{deg} degrees = {rad} radians")
            
        elif choice == "3":
            rad = get_float("Enter an angle in radians: ")
            deg = math.degrees(rad)
            print(f"\n{rad} radians = {deg} degrees")
            
        elif choice == "4":
            deg = get_float("Enter an angle in degrees: ")
            rad = math.radians(deg) #sin/cos/tan in radians!
            print(f"\nAngle = {deg} degrees ({rad} radians)")
            print(f"sin({deg}) = {math.sin(rad)}")
            print(f"cos({deg}) = {math.cos(rad)}")
            print(f"tan({deg}) = {math.tan(rad)}")
            
        elif choice == "5":
            val = get_float("Enter a value: ")
            print()
            try:
                print(f"asin({val}) = {math.asin(val)} radians")
                print(f"{math.degrees(math.asin(val))} degrees")
            except ValueError:
                print("asin(x) needs -1 <= x <= 1. Skipped.")

            try:
                print(f"acos({val}) = {math.acos(val)} radians")
                print(f"{math.degrees(math.acos(val))} degrees")
            except ValueError:
                print("acos(x) needs -1 <= x <= 1. Skipped.")

            print(f"atan({val}) = {math.atan(val)} radians")
            print(f"{math.degrees(math.atan(val))} degrees")

        elif choice == "0":
            break

        else:
            print("Invalid choice. Please try again.")

        pause()

# SECTION 2: HYPERBOLIC FUNCTIONS
# math.sinh, math.cosh, math.tanh, math.asinh, math.acosh, math.atanh
